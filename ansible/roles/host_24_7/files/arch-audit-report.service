[Unit]
Description=Write arch-audit CVE report as JSON for the dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# User=nobody, NOT DynamicUser=yes: DynamicUser puts StateDirectory under
# /var/lib/private (0700 root) behind a symlink — unreadable for the operator
# and an ugly coupling for the pod's hostPath mount. nobody is uid 65534,
# the same identity the Glance pod runs as.
User=nobody
StateDirectory=arch-audit
# Report must stay world-readable — the Glance pod (uid 65534) reads it via a
# read-only hostPath mount.
UMask=0022
# Atomic rename so the pod never reads a half-written file.
ExecStart=/bin/sh -c 'arch-audit --json > /var/lib/arch-audit/.report.json.tmp && mv /var/lib/arch-audit/.report.json.tmp /var/lib/arch-audit/report.json'
